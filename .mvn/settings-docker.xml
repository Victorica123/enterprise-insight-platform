<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!--
    Docker-build-only Maven settings. Routes Maven Central through the Aliyun
    public mirror so `mvn dependency:go-offline` / `package` inside the image
    build downloads reliably on mainland-China networks. Host-side development
    is unaffected (host mvn keeps its own ~/.m2/settings.xml). Referenced only
    by Dockerfile via COPY into /root/.m2/settings.xml.
  -->
  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
