# Copy this file to .env on the server and change every value marked CHANGE_ME.

# Public entrypoint.
PUBLIC_APP_DOMAIN=video.example.com
PUBLIC_FILES_DOMAIN=files.example.com
PUBLIC_APP_URL=https://video.example.com
SERVER_PORT=8081

# Application secrets. Use at least 32 random characters for JWT.
APP_JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS_123456
APP_JWT_EXPIRATION_SECONDS=86400
# 统一生产试点使用根目录 compose.local-prod.yml 的 RS256/JWKS 配置；
# 这个 Media-only 部署模板保留 HS256，不能作为统一平台生产身份基线。

# MySQL.
MYSQL_DATABASE=videoplatform
MYSQL_USERNAME=videoplatform
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Complete JDBC URL used by the app container; keep the database name aligned above.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/videoplatform?useSSL=false&serverTimezone=Asia/Shanghai
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Redis. The app reaches Redis through the Docker network.
APP_REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# RocketMQ. Keep enabled for queue/backpressure validation.
APP_MQ_ENABLED=true
APP_MQ_CONSUMER_THREADS=4
ROCKETMQ_NAMESERVER=rocketmq-namesrv:9876
# Per-user admission control: only QUEUED/TRANSCRIBING/SUMMARIZING tasks count.
APP_MAX_ACTIVE_TASKS_PER_USER=5

# Storage. For small public trials, prefer MinIO/S3 direct upload over app-server disk upload.
APP_STORAGE_TYPE=s3
APP_STORAGE_BASE_PATH=/app/storage
APP_STORAGE_S3_ENDPOINT=http://minio:9000
APP_STORAGE_S3_PUBLIC_ENDPOINT=https://files.example.com
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_BUCKET=video-platform
# These two are the SINGLE source of truth for object-storage credentials.
# docker-compose.prod.yml feeds the same values into MinIO as its root user/password,
# so the app and MinIO can never drift apart. Do NOT add a separate
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD here — that reintroduces the mismatch bug where
# the app signs requests MinIO rejects with 403 SignatureDoesNotMatch and every upload fails.
APP_STORAGE_S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
APP_STORAGE_S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
APP_STORAGE_S3_PATH_STYLE_ACCESS=true
MINIO_API_CORS_ALLOW_ORIGIN=https://video.example.com
# Media lifecycle: retry failed object deletion and reclaim interrupted chunk uploads after 24 hours.
APP_MEDIA_CLEANUP_RETRY_INTERVAL_MS=60000
APP_CHUNK_CLEANUP_SCAN_INTERVAL_MS=600000
APP_CHUNK_CLEANUP_INITIAL_DELAY_MS=60000
APP_CHUNK_RETENTION=24h

# Automatic pilot retention (raw media/transcript/audit policy from ADR-0014).
APP_RETENTION_ENABLED=true
APP_RETENTION_MEDIA_DAYS=30
APP_RETENTION_TRANSCRIPT_DAYS=180
APP_RETENTION_AUDIT_DAYS=365

# External model calls are production deny-by-default and require approved tenant ids.
APP_MODEL_EGRESS_POLICY=allowlist
APP_MODEL_EGRESS_ALLOWED_TENANTS=

# Processing mode.
# Start with mock mode for deployment smoke tests. Turn these on only after FFmpeg and API keys are ready.
APP_TRANSCRIPT_ENABLED=false
APP_SUMMARY_ENABLED=false
APP_TRANSCRIPT_MOCK_DELAY_MS=500
WHISPER_API_BASE_URL=https://api.siliconflow.cn/v1
WHISPER_API_KEY=
WHISPER_MODEL=iic/SenseVoiceSmall
FFMPEG_PATH=ffmpeg
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Recovery.
APP_WORKFLOW_REAPER_ENABLED=true
APP_WORKFLOW_STALE_TASK_TIMEOUT=60m
APP_WORKFLOW_REAPER_INTERVAL_MS=60000
APP_WORKFLOW_REAPER_INITIAL_DELAY_MS=60000
APP_AGENT_CLAIM_LEASE_DURATION_MS=30000

# Observability.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
