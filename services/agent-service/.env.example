# 复制为 .env 后按需修改；所有配置都有安全默认值，零配置即可本地运行。
# 环境变量优先级：进程环境变量 > 本文件。

# ---- 身份与服务间认证 ----
# production 必须设为 jwt；development 才允许旧演示身份头。
AGENT_AUTH_MODE=development
APP_ENV=development
# 与 Media Service 的 APP_JWT_SECRET 相同，至少 32 字节；禁止提交真实值。
#SHARED_JWT_SECRET=replace-with-at-least-32-random-bytes
# 生产试点使用 RS256，并从 Media Service 的 JWKS 端点取公钥；开发默认 HS256。
JWT_ALGORITHM=HS256
#JWT_JWKS_URL=http://127.0.0.1:8081/api/auth/jwks
APP_JWT_ISSUER=enterprise-insight
APP_JWT_AUDIENCE=enterprise-insight-api
JWT_CLOCK_SKEW_SECONDS=30
# Media Service 调用 /internal/v1/media/transcripts 的独立服务凭证。
#MEDIA_INGEST_SERVICE_TOKEN=replace-with-a-random-service-token

# ---- 持久化 ----
# 开发默认使用 AGENT_DATABASE_PATH 指向的 SQLite；生产试点必须使用 MySQL。
#AGENT_DATABASE_URL=mysql://agent_user:password@127.0.0.1:3306/agent_platform?charset=utf8mb4
#AGENT_REQUIRE_MYSQL=1

# ---- 数据保留期 ----
# 生产试点：视频转写证据 180 天，交互与审批审计 365 天；每批有界删除。
#RETENTION_ENABLED=1
#RETENTION_TRANSCRIPT_DAYS=180
#RETENTION_AUDIT_DAYS=365
#RETENTION_BATCH_SIZE=200
#RETENTION_SCAN_INTERVAL_SECONDS=3600

# ---- LLM 接入（可选；不配 Key 则使用本地模板回答模式） ----
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
# OpenAI 兼容通道（LLM_PROVIDER=openai 时使用）
#OPENAI_API_KEY=sk-your-openai-api-key
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4.1-mini

# ---- 外部模型数据出境门禁 ----
# production 无论此值如何都强制按租户白名单放行；未列入的工作区只能走本地降级。
MODEL_EGRESS_POLICY=allow
#MODEL_EGRESS_ALLOWED_TENANTS=tenant-id-1,tenant-id-2

# ---- 回答与检索默认值 ----
# local=内置模板（零依赖）；api=调用 LLM；auto=有 Key 用 API、失败降级
DEFAULT_ANSWER_MODE=local
# keyword / embedding / hybrid
RETRIEVER_MODE=keyword

# ---- LLM 客户端策略 ----
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_COMPLETION_TOKENS=1200
# auto：OpenAI 使用严格 JSON Schema，DeepSeek 使用 JSON Object；也可显式设 json_schema/json_object/off
LLM_RESPONSE_FORMAT=auto

# ---- token 成本核算单价（美元 / 1M tokens，默认 DeepSeek 公开价） ----
#LLM_PROMPT_PRICE_PER_1M_USD=0.27
#LLM_COMPLETION_PRICE_PER_1M_USD=1.10

# ---- Agentic 开关 ----
# LLM 路由/检索规划/工具选择（0=纯规则版，离线门禁与 CI 默认关闭）
#LLM_ROUTER_ENABLED=1
# 审批职责分离：已知身份下发起人不能审批自己的写操作（0=关闭）
#APPROVAL_SOD_ENFORCED=1
# 每请求调用上限（对标 Nexus：模型 8 次、工具 6 次）；超限降级为规则 / 模板并写 trace，不报错
#AGENT_MAX_MODEL_CALLS=8
#AGENT_MAX_TOOL_CALLS=6
# 证据字符预算：单来源 / 总量上限；先按最终排名选来源，再按预算裁剪
#EVIDENCE_SOURCE_CHAR_BUDGET=2200
#EVIDENCE_TOTAL_CHAR_BUDGET=5200
# 提示词模板目录覆盖：默认用 app/prompts/*.txt，此目录下同名文件优先（改措辞不用重建镜像）
#AGENT_PROMPT_DIR=

# ---- 检索增强（可选安装 requirements-embedding.txt 后生效） ----
# 真实语义 embedding；置空强制哈希降级
#EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# cross-encoder 精排（增加延迟，默认关闭）
#RERANKER_MODEL=
# 通道先过滤再融合；阈值使用 0–100 的相关性分数，hash 不能当作语义向量
#HYBRID_KEYWORD_MIN_RATIO=0.35
#HYBRID_SEMANTIC_MIN_SCORE=45
#HYBRID_HASH_MIN_SCORE=10
# 每条通道独立截止；满员立即降级，无无界队列。容量修改后需重启进程
#HYBRID_CHANNEL_TIMEOUT_SECONDS=2
#HYBRID_RERANK_TIMEOUT_SECONDS=3
#HYBRID_CHANNEL_WORKERS=4
# 缺失向量在后台补齐，检索不会现场推理文档；旧 JSON 与二进制列同时保留
#EMBEDDING_REBUILD_BATCH_SIZE=64
#EMBEDDING_BACKFILL_INTERVAL_SECONDS=60

# ---- 服务 ----
# python -m app.serve / Docker 使用此 worker 数；缓存与模型内存按进程倍增
#AGENT_WORKERS=1
# HTTP 同步处理与 SSE 共用 anyio 线程池；分析 specialist 使用独立的有界池
#AGENT_THREAD_POOL_SIZE=40
#AGENT_SPECIALIST_WORKERS=4
# 活跃会话每 1/3 租约时长续租；同会话串行，超时旧执行者不能提交结果
#CONVERSATION_LEASE_SECONDS=120
# 上传大小上限（字节，默认 50MB）
#MAX_UPLOAD_BYTES=52428800
# 日志：默认 JSON 行格式；1=人类可读；级别 DEBUG/INFO/WARNING
#LOG_FORMAT_TEXT=1
#LOG_LEVEL=INFO
