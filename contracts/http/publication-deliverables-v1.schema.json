{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-insight.local/contracts/http/publication-deliverables-v1.schema.json",
  "title": "PublicationDeliverablesV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "knowledge_candidates", "action_items"],
  "properties": {
    "version": { "$ref": "#/$defs/version" },
    "knowledge_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledgeCandidate" }
    },
    "action_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionItem" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source_type", "document_id", "filename", "chunk_index", "excerpt"],
      "properties": {
        "source_type": { "enum": ["document", "video"] },
        "document_id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string" },
        "chunk_index": { "type": "integer", "minimum": 0 },
        "excerpt": { "type": "string" },
        "asset_id": { "type": ["string", "null"] },
        "segment_id": { "type": ["string", "null"] },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 0 },
        "speaker": { "type": ["string", "null"] }
      }
    },
    "version": {
      "type": "object",
      "required": ["version_id", "session_id", "tenant_id", "owner_id", "version_number", "content_sha256", "prd", "published_by", "published_at"],
      "properties": {
        "version_id": { "type": "string", "format": "uuid" },
        "session_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "owner_id": { "type": "string", "minLength": 1 },
        "version_number": { "type": "integer", "minimum": 1 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "prd": { "type": "object" },
        "published_by": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date-time" }
      }
    },
    "knowledgeCandidate": {
      "type": "object",
      "required": ["candidate_id", "session_id", "version_id", "tenant_id", "owner_id", "requirement_id", "statement", "evidence", "status", "created_by", "created_at"],
      "properties": {
        "candidate_id": { "type": "string", "format": "uuid" },
        "session_id": { "type": "string", "format": "uuid" },
        "version_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "owner_id": { "type": "string", "minLength": 1 },
        "requirement_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "decided_by": { "type": ["string", "null"] },
        "decided_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "actionItem": {
      "type": "object",
      "required": ["action_item_id", "session_id", "version_id", "tenant_id", "owner_id", "requirement_id", "title", "description", "priority", "evidence", "status", "created_at", "updated_at"],
      "properties": {
        "action_item_id": { "type": "string", "format": "uuid" },
        "session_id": { "type": "string", "format": "uuid" },
        "version_id": { "type": "string", "format": "uuid" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "owner_id": { "type": "string", "minLength": 1 },
        "requirement_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["low", "medium", "high", "critical"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "enum": ["DRAFT", "TICKET_PENDING_APPROVAL", "TICKET_CREATED", "TICKET_REJECTED", "TICKET_FAILED"] },
        "pending_action_id": { "type": ["string", "null"] },
        "ticket_id": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
