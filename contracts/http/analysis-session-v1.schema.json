{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-insight.local/contracts/http/analysis-session-v1.schema.json",
  "title": "AnalysisSessionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id", "tenant_id", "owner_id", "objective", "asset_ids", "status",
    "current_stage", "checkpoint_version", "evidence_revision",
    "evidence_snapshot_sha256", "retrieval_mode", "resume_token", "stages",
    "open_questions", "confirmations", "prd", "publication", "created_at", "updated_at"
  ],
  "properties": {
    "session_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 3, "maxLength": 1000 },
    "asset_ids": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
    "status": { "enum": ["RUNNING", "WAITING_CONFIRMATION", "DRAFT_READY", "PUBLISH_PENDING", "PUBLISHED", "FAILED"] },
    "current_stage": { "type": "integer", "minimum": 1, "maximum": 6 },
    "checkpoint_version": { "type": "integer", "minimum": 1 },
    "evidence_revision": { "type": "integer", "minimum": 0 },
    "evidence_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retrieval_mode": { "const": "hybrid" },
    "resume_token": { "type": ["string", "null"] },
    "stages": { "type": "array", "minItems": 5, "maxItems": 6, "items": { "$ref": "#/$defs/stage" } },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "confirmations": { "type": "object", "additionalProperties": { "type": "string" } },
    "prd": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/prd" }] },
    "publication": { "type": ["object", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "reason", "required"],
      "properties": {
        "question_id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "document_id", "filename", "chunk_index", "excerpt", "asset_id", "segment_id", "start_ms", "end_ms", "speaker"],
      "properties": {
        "source_type": { "enum": ["document", "video"] },
        "document_id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string" },
        "chunk_index": { "type": "integer", "minimum": 0 },
        "excerpt": { "type": "string" },
        "asset_id": { "type": ["string", "null"] },
        "segment_id": { "type": ["string", "null"] },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 0 },
        "speaker": { "type": ["string", "null"] }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "summary", "findings", "evidence", "open_questions"],
      "properties": {
        "stage": { "enum": ["intent", "stakeholders", "domain", "risks", "convergence", "prd"] },
        "status": { "enum": ["COMPLETED", "WAITING_CONFIRMATION"] },
        "summary": { "type": "string" },
        "findings": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "open_questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "title", "description", "acceptance_criteria", "evidence", "assumptions"],
      "properties": {
        "requirement_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "executive_summary", "goals", "stakeholders", "requirements", "risks", "open_questions", "publication_status"],
      "properties": {
        "title": { "type": "string" },
        "executive_summary": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } },
        "stakeholders": { "type": "array", "items": { "type": "string" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "publication_status": { "enum": ["DRAFT", "PUBLISH_PENDING", "PUBLISHED"] }
      }
    }
  }
}
