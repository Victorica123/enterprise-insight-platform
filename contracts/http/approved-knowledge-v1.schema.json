{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-insight.local/contracts/http/approved-knowledge-v1.schema.json",
  "title": "Approved knowledge materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "session_id",
    "version_id",
    "tenant_id",
    "owner_id",
    "requirement_id",
    "statement",
    "evidence",
    "status",
    "created_by",
    "created_at",
    "decided_by",
    "decided_at",
    "knowledge_document_id",
    "knowledge_content_sha256",
    "knowledge_published_at"
  ],
  "properties": {
    "candidate_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string", "format": "uuid" },
    "version_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "requirement_id": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "publication-deliverables-v1.schema.json#/$defs/evidence" }
    },
    "status": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "decided_by": { "type": ["string", "null"] },
    "decided_at": { "type": ["string", "null"], "format": "date-time" },
    "knowledge_document_id": { "type": ["string", "null"] },
    "knowledge_content_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "knowledge_published_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "APPROVED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "knowledge_document_id": { "type": "string", "minLength": 1 },
          "knowledge_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "knowledge_published_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ]
}
